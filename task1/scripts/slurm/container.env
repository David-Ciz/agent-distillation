# container.env — single source of truth for the LUMI container path.
# Source this file in every SLURM job script:
#
#   source "$(dirname "$0")/container.env"
#
# When LUMI AI Factory releases a new container, update SIF here only.

export SIF=/appl/local/laifs/containers/lumi-multitorch-u24r64f21m43t29-20260124_092648/lumi-multitorch-full-u24r64f21m43t29-20260124_092648.sif

# Optional: path to a project-local pip venv layered on top of the container.
# Leave empty unless you have confirmed that the venv can still import the
# container's torch/ROCm stack. For the current Qwen3.5 workaround, prefer the
# PYTHONPATH override below and keep this empty.
#
# Create with:
#   singularity shell $SIF
#   python -m venv $VENV_PATH --system-site-packages
#   source $VENV_PATH/bin/activate && pip install mlflow ...
# Override per job if needed:
#   CONTAINER_VENV=/path/to/venv sbatch ...
export CONTAINER_VENV="${CONTAINER_VENV:-}"

# Optional: path to a Python package override directory prepended to PYTHONPATH.
# Use this when the container's bundled packages are too old for a specific model
# family, e.g. a newer Hugging Face stack for Qwen3.5.
# Create with:
#   singularity shell $SIF
#   python -m pip install --target $OVERRIDE_DIR --upgrade --ignore-installed \
#       "transformers==5.2.0"
# Important:
#   Do not install a second torch/triton/CUDA stack into this override dir.
#   If pip starts downloading torch, triton, nvidia_*, or cuda_* wheels while
#   testing compiled extras such as flash-linear-attention, stop and retry with
#   --no-deps or a more targeted install. The override dir must not shadow the
#   container's ROCm torch build.
# Override per job if needed, e.g.:
#   CONTAINER_PYTHON_OVERRIDES=/scratch/project_465002758/$USER/qwen35-test-overrides sbatch ...
# Multiple paths are allowed via a colon-separated PYTHONPATH-style string, e.g.:
#   CONTAINER_PYTHON_OVERRIDES=$HOME/agent-distillation/py-overrides-collapse:$HOME/agent-distillation/py-overrides
# Leave empty if not using an override.
export CONTAINER_PYTHON_OVERRIDES="${CONTAINER_PYTHON_OVERRIDES:-${HOME}/agent-distillation/py-overrides}"

if [[ -n "${CONTAINER_PYTHON_OVERRIDES:-}" ]]; then
    export PYTHONPATH="${CONTAINER_PYTHON_OVERRIDES}${PYTHONPATH:+:${PYTHONPATH}}"
    export SINGULARITYENV_PYTHONPATH="${PYTHONPATH}"
    export APPTAINERENV_PYTHONPATH="${PYTHONPATH}"
fi

# ---------------------------------------------------------------------------
# Cache redirection — keep ALL large caches off the home dir (20 GB quota).
# HuggingFace model weights alone can exceed this for a single 7B model.
# ---------------------------------------------------------------------------
_SCRATCH="/scratch/project_465002758/${USER}"

export HF_HOME="${_SCRATCH}/huggingface"
export HUGGINGFACE_HUB_CACHE="${_SCRATCH}/huggingface/hub"
export TRANSFORMERS_CACHE="${_SCRATCH}/huggingface/hub"
export HF_DATASETS_CACHE="${_SCRATCH}/huggingface/datasets"

# pip / torch compile caches
export PIP_CACHE_DIR="${_SCRATCH}/pip-cache"
export TORCH_HOME="${_SCRATCH}/torch"

mkdir -p "${HF_HOME}" "${PIP_CACHE_DIR}" "${TORCH_HOME}"
