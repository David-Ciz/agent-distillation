# DVC ignores — patterns here are excluded from DVC tracking.
# Syntax is the same as .gitignore.

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoints
.ipynb_checkpoints/

# OS artefacts
.DS_Store
Thumbs.db

# Editor metadata
.vscode/
.idea/

# Logs (not data)
*.log

# MLflow runs directory (tracked by MLflow, not DVC)
mlruns/
mlflow.db

